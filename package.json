{
  "name": "dsh-sticky-notes",
  "version": "1.0.1",
  "description": "Sticky notes plugin for DeepSeek Harness \u2014 quick notes with colored labels, pin, timed reminders, and password protection. / \u6ce1\u6ce1\u732b\u7684\u5373\u65f6\u4fbf\u7b7e \u2014 \u5728 DSH \u968f\u65f6\u8bb0\u5f55\u4e8b\u60c5\uff0c\u652f\u6301\u5f69\u8272\u6807\u7b7e\u3001\u7f6e\u9876\u3001\u5b9a\u65f6\u63d0\u9192\u548c\u5bc6\u7801\u4fdd\u62a4\u3002",
  "type": "module",
  "license": "MIT",
  "author": "paopaocat",
  "homepage": "https://github.com/zmm863-commits/dsh-sticky-notes",
  "repository": {
    "type": "git",
    "url": "https://github.com/zmm863-commits/dsh-sticky-notes.git"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "notes",
    "sticky-notes",
    "reminder",
    "password",
    "\u4fbf\u7b7e",
    "\u63d0\u9192",
    "\u5bc6\u7801\u4fdd\u62a4"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-runtime": "^0.1.0-rc.6"
  }
}